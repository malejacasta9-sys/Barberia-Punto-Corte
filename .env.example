# =============================================================================
# VARIABLES DE ENTORNO PÚBLICAS - PUNTO CORTE CITAS (VITE + SUPABASE)
# =============================================================================
# Copia este archivo como '.env' en la raíz del proyecto y completa con las credenciales
# de tu proyecto en Supabase (https://supabase.com/dashboard/project/_/settings/api).
# En Vite, solo las variables que comienzan con VITE_ son expuestas al código cliente.
# =============================================================================

# URL del Proyecto Supabase (Project URL, sin /rest/v1/)
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co

# Llave Pública de Supabase (anon public key o sb_publishable_...)
VITE_SUPABASE_ANON_KEY=tu_llave_publica_aqui

# Nombre de la aplicación (opcional para branding de la interfaz)
VITE_APP_NAME="Punto Corte - Gestión de Citas"
